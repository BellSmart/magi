# MAGI 生产环境变量。
#
# 安装脚本会把它复制到 /etc/magi/magi.env（root:magi 0640），并替换 __GENERATE__。
# 这个文件等价于服务器的私钥总集：不要提交到仓库，不要放进备份的明文目录。

MAGI_ENV=prod
MAGI_SECRET_KEY=__GENERATE__
MAGI_DATABASE_URL=sqlite:////var/lib/magi/magi.db
MAGI_AGENTS_CONFIG_PATH=/opt/magi/config/agents.yaml
MAGI_SECURE_COOKIES=true
MAGI_PUBLIC_ORIGIN=https://__PUBLIC_IP__
MAGI_MAX_OUTPUT_TOKENS=8000

# --- 模型 provider ---
# 三个 agent 默认都指向 DeepSeek，这一个 key 就能跑通。
DEEPSEEK_API_KEY=__SET_ME__
# 若要启用异构模型，再填下面两个，并在 config/agents.yaml 的 models 白名单里解注。
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# --- 检索 ---
TAVILY_API_KEY=__SET_ME__
