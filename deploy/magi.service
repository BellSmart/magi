[Unit]
Description=MAGI three-persona voting service
Documentation=https://github.com/TomaszRewak/MAGI
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=magi
Group=magi
WorkingDirectory=/opt/magi
EnvironmentFile=/etc/magi/magi.env
# /opt/magi 在 ProtectSystem=strict 下是只读的，禁止 Python 尝试写 __pycache__。
Environment=PYTHONDONTWRITEBYTECODE=1

# 只监听回环：外网访问一律经 nginx。
# --proxy-headers 让 uvicorn 采信 X-Forwarded-For，否则登录限流会把所有人当成 127.0.0.1。
ExecStart=/opt/magi/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header

Restart=always
RestartSec=3
TimeoutStopSec=20

# --- 沙箱化 ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/magi
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
