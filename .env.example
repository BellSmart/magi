# 运行期配置模板。复制成 .env 后填写；.env 已被 git 忽略。
# 生成密钥：python -m app.cli gen-secret
MAGI_ENV=dev
MAGI_SECRET_KEY=
MAGI_DATABASE_URL=sqlite:///data/magi.db
MAGI_SECURE_COOKIES=false
MAGI_PUBLIC_ORIGIN=http://127.0.0.1:8000

# --- 三个 agent 的 provider 密钥 ---
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# --- 检索 ---
TAVILY_API_KEY=

# --- agent 配置 ---
# 默认 config/agents.yaml（三家分别是 DeepSeek / Kimi / 千问）。
# 想先看界面而不消耗额度：改成 config/agents.mock.yaml 走 mock provider。
MAGI_AGENTS_CONFIG_PATH=config/agents.yaml

# --- 成本护栏 ---
MAGI_GLOBAL_DAILY_BUDGET_YUAN=30
